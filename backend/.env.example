DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# 生产：DJANGO_ENV=production（加载 production settings）
DJANGO_ENV=local
# 局域网访问时追加 http://<局域网IP>:5180
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 生产示例：CSRF_TRUSTED_ORIGINS=https://claner.example.com
CSRF_TRUSTED_ORIGINS=
# 局域网访问时追加 http://<局域网IP>:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# 开发与生产均使用 PostgreSQL（勿默认 SQLite）
DATABASE_URL=postgres://claner:claner@127.0.0.1:5433/claner

# 存储：local（开发默认）| oss（生产/联调阿里云）
STORAGE_BACKEND=local

# local 模式可留空：file_url / local-put 用相对路径，经 Vite 代理，手机局域网可显示
# 仅在「不用 Vite、直连 Django」时再填绝对地址，例如 http://192.168.x.x:8001
PUBLIC_API_BASE_URL=

# OSS（STORAGE_BACKEND=oss 时必填；图片/视频/音频共用同一 Bucket）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=claner
# 地域 Endpoint，勿带 bucket 名，例如：
# https://oss-cn-chengdu.aliyuncs.com
OSS_ENDPOINT=
OSS_REGION=cn-chengdu
# 可选：CDN / 自定义域名（有则 file_url 用它；否则用 bucket.endpoint）
OSS_CUSTOM_DOMAIN=

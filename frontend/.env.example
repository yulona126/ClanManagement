# 留空 = 走当前页面同源（Vite 把 /api、/media 代理到本机 8001）
# 手机访问 http://<电脑局域网IP>:5180 即可登录，无需改 IP
# 若要直连后端，再写成例如：http://192.168.50.247:8001
VITE_API_BASE_URL=

# —— 本地调试连线上 API（可选）——
# 走 Vite 服务端代理，浏览器仍是同源请求，所以**不需要改线上 CORS**。
# DEV_API_TARGET=https://你的线上域名
#
# 强烈建议同时开只读：登录/GET 放行，其余写请求一律 403，避免误改线上数据。
# DEV_API_READONLY=1

# Copy to `.env` in the repo root, then:
#   docker compose up -d --build

# —— Postgres ——
POSTGRES_USER=claner
POSTGRES_PASSWORD=claner
POSTGRES_DB=claner
POSTGRES_PUBLISH_PORT=5433

# —— Web (nginx) ——
WEB_PUBLISH_PORT=80

# —— Django ——
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# First bring-up on plain HTTP; set true when TLS terminates in front
SECURE_SSL_REDIRECT=false

# Filled by compose for the api service; keep for reference
# DATABASE_URL=postgres://claner:claner@db:5432/claner

# —— Storage ——
# oss = 阿里云直传（推荐生产；列表缩略图靠 x-oss-process）
# local = Docker 卷（调试 / 无 OSS 时）
STORAGE_BACKEND=oss
PUBLIC_API_BASE_URL=
# 上传登记前校验图片真实字节（排查黑图 / 防脏数据）。
# 每张图会多一次对象存储 Range 读（约 20–50ms）；置 0 可关闭。
MEDIA_BYTE_CHECK=1

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=claner
OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
OSS_REGION=cn-chengdu
OSS_CUSTOM_DOMAIN=
